{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "../build/electron",
    "types": ["node"]
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "shared/**/*.ts"],
  "exclude": ["main/**/*.test.ts"]
}
