{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "../build/electron",
    "types": ["node"]
  },
  "include": [
    "main/providers/claude/claudeWorker.mts",
    "main/providers/claude/claudeWorkerProtocol.ts",
    "main/providers/claude/claudeRedaction.ts",
    "main/providers/claude/claudeImageInput.ts",
    "main/providers/claude/claudeHistorySearch.ts",
    "shared/protocol.ts",
    "shared/agentProtocol.ts"
  ]
}
